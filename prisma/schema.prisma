generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  name               String?
  role               Role                @default(STUDENT)
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  adminReviews       AdminReview[]       @relation("ReviewedBy")
  applications       Application[]
  notifications      Notification[]
  opportunityReports OpportunityReport[]
  savedOpportunities SavedOpportunity[]
  searchPreferences  SearchPreference[]
  profile            StudentProfile?
}

model StudentProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  displayName        String?
  country            String?
  degreeLevel        DegreeLevel?
  degreeProgram      String?
  university         String?
  academicYear       String?
  gpa                Float?
  graduationYear     Int?
  skills             String[]
  researchInterests  String[]
  preferredCountries String[]
  fundingPreference  FundingType?
  remotePreference   RemoteStatus?
  languageTestStatus String?
  fieldId            String?
  subfieldId         String?
  notificationOptIn  Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  field              Field?        @relation(fields: [fieldId], references: [id])
  subfield           Subfield?     @relation(fields: [subfieldId], references: [id])
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Field {
  id            String           @id @default(cuid())
  name          String           @unique
  opportunities Opportunity[]
  profiles      StudentProfile[]
  subfields     Subfield[]
}

model Subfield {
  id            String           @id @default(cuid())
  name          String
  fieldId       String
  opportunities Opportunity[]
  profiles      StudentProfile[]
  field         Field            @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, name])
}

model OpportunityCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  opportunities Opportunity[]
}

model Provider {
  id            String        @id @default(cuid())
  name          String        @unique
  website       String?
  opportunities Opportunity[]
}

model OpportunitySource {
  id            String        @id @default(cuid())
  name          String
  url           String
  type          String?
  lastCrawledAt DateTime?
  createdAt     DateTime      @default(now())
  opportunities Opportunity[]
}

model Opportunity {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  providerId         String?
  categoryId         String
  fieldId            String?
  subfieldId         String?
  location           String?
  eligibleCountries  String[]
  degreeLevels       DegreeLevel[]
  experienceLevel    String?
  remoteStatus       RemoteStatus        @default(NOT_SPECIFIED)
  skills             String[]
  fundingType        FundingType         @default(NOT_SPECIFIED)
  fundingDetails     String?
  salary             String?
  deadline           DateTime?
  duration           String?
  requirements       String?
  documents          String[]
  applicationUrl     String
  sourceId           String?
  sourceUrl          String?
  verificationStatus VerificationStatus  @default(NEEDS_REVIEW)
  publishedAt        DateTime?
  updatedAt          DateTime            @updatedAt
  lastCheckedAt      DateTime?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  adminReviews       AdminReview[]
  applications       Application[]
  category           OpportunityCategory @relation(fields: [categoryId], references: [id])
  field              Field?              @relation(fields: [fieldId], references: [id])
  provider           Provider?           @relation(fields: [providerId], references: [id])
  source             OpportunitySource?  @relation(fields: [sourceId], references: [id])
  subfield           Subfield?           @relation(fields: [subfieldId], references: [id])
  reports            OpportunityReport[]
  savedBy            SavedOpportunity[]

  @@index([categoryId])
  @@index([fieldId])
  @@index([deadline])
  @@index([verificationStatus])
}

model SavedOpportunity {
  id            String      @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(SAVED)
  notes         String?
  appliedAt     DateTime?
  reminderAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SearchPreference {
  id        String   @id @default(cuid())
  userId    String
  name      String?
  query     String?
  filters   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminReview {
  id            String      @id @default(cuid())
  opportunityId String
  reviewerId    String?
  action        String
  notes         String?
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  reviewer      User?       @relation("ReviewedBy", fields: [reviewerId], references: [id])
}

model OpportunityReport {
  id            String      @id @default(cuid())
  opportunityId String
  userId        String?
  reason        String
  details       String?
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])
}

enum Role {
  STUDENT
  ADMIN
}

enum DegreeLevel {
  HIGH_SCHOOL
  UNDERGRADUATE
  MASTERS
  PHD
  POSTDOC
  OTHER
}

enum FundingType {
  FULLY_FUNDED
  PARTIALLY_FUNDED
  UNFUNDED
  PAID
  UNPAID
  NOT_SPECIFIED
}

enum RemoteStatus {
  REMOTE
  HYBRID
  ON_SITE
  NOT_SPECIFIED
}

enum VerificationStatus {
  VERIFIED
  NEEDS_REVIEW
  EXPIRED
  REPORTED
}

enum ApplicationStatus {
  SAVED
  PREPARING
  APPLIED
  INTERVIEW
  SELECTED
  REJECTED
}

enum NotificationType {
  NEW_MATCH
  DEADLINE_APPROACHING
  SAVED_UPDATED
  APPLICATION_REMINDER
  DIGEST
}
